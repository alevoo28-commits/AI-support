# ============================================================
# PLANTILLA: Variables de entorno para AI-Support
# 
# INSTRUCCIONES:
# 1. Copiar este archivo como ".env"
# 2. Llenar los valores según tu entorno
# 3. NUNCA hacer commit de .env (ya está en .gitignore)
# ============================================================

# ============================================================
# LLM (GitHub Models o LM Studio)
# ============================================================

# GitHub Models (recomendado para dev)
AI_SUPPORT_LLM_PROVIDER=github
AI_SUPPORT_LLM_BASE_URL=https://models.inference.ai.azure.com
AI_SUPPORT_LLM_API_KEY=your_github_models_api_key_here
AI_SUPPORT_LLM_MODEL=gpt-4o-mini

# LM Studio (local, sin costo)
# AI_SUPPORT_LLM_PROVIDER=lmstudio
# AI_SUPPORT_LLM_BASE_URL=http://localhost:1234/v1
# AI_SUPPORT_LLM_API_KEY=not-needed
# AI_SUPPORT_LLM_MODEL=local-model

# Timeout en segundos
AI_SUPPORT_LLM_TIMEOUT_SECONDS=120

# Mode rápido para GitHub (reduce latencia)
AI_SUPPORT_GITHUB_FAST_MODE=true

# ============================================================
# EMBEDDINGS (OpenAI o Local)
# ============================================================

# OpenAI
AI_SUPPORT_EMBEDDINGS_PROVIDER=openai
AI_SUPPORT_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
AI_SUPPORT_EMBEDDINGS_API_KEY=your_openai_api_key_here
AI_SUPPORT_EMBEDDINGS_MODEL=text-embedding-3-small

# Local (sin costo)
# AI_SUPPORT_EMBEDDINGS_PROVIDER=none
# AI_SUPPORT_EMBEDDINGS_BASE_URL=
# AI_SUPPORT_EMBEDDINGS_API_KEY=
# AI_SUPPORT_EMBEDDINGS_MODEL=

# ============================================================
# MYSQL: Almacenamiento de prompts
# ============================================================

# Habilitar MySQL para prompts externalizados
AI_SUPPORT_MYSQL_ENABLE=true

# Conexión a MySQL
AI_SUPPORT_MYSQL_HOST=localhost
AI_SUPPORT_MYSQL_PORT=3306
AI_SUPPORT_MYSQL_USER=ai_support_user
AI_SUPPORT_MYSQL_PASSWORD=Ai#Support2024$Secure!
AI_SUPPORT_MYSQL_DATABASE=ai_support

# ============================================================
# GOOGLE SHEETS (Opcional: traer datos de hojas)
# ============================================================

# ID de la hoja de Google Sheets (si aplica)
# GOOGLE_SHEET_ID=your_sheet_id_here
# GOOGLE_SHEET_CREDENTIALS=/path/to/credentials.json

# ============================================================
# LOGGING
# ============================================================

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Archivo de log
LOG_FILE=logs/ai_support.log

# ============================================================
# APP (Streamlit)
# ============================================================

# Host y puerto
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# ============================================================
# DESARROLLO
# ============================================================

# Si está en desarrollo
DEBUG=false

# ============================================================
# NOTAS IMPORTANTES
# ============================================================

# 1. NUNCA hacer commit de este .env
#    - Ya está en .gitignore
#    - Contiene credenciales sensibles

# 2. Credenciales de GitHub Models:
#    - Crear en: https://github.com/settings/tokens
#    - Seleccionar: "Codespaces" scope

# 3. Credenciales de OpenAI:
#    - Crear en: https://platform.openai.com/api-keys
#    - Agregar presupuesto o tarjeta de crédito

# 4. MySQL:
#    - Ejecutar: .\scripts\setup_mysql_user.ps1 -MySQLRootPassword "tu_password"
#    - Ve: docs/SETUP_MYSQL_USER.md

# 5. Para development:
#    - Usar GitHub Models (gratis con GitHub account)
#    - Usar Embeddings local o "none"
#    - MySQL es IMPORTANTE para prompts externalizados

# ============================================================
